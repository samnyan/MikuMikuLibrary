  <Import Project="..\MikuMikuLibrary.Shared\MikuMikuLibrary.Shared.projitems" Label="Shared" />
  
  <PropertyGroup>
    <NativeOutputRoot>$(MSBuildProjectDirectory)\..\MikuMikuLibrary.Native\bin\$(Configuration)</NativeOutputRoot>
  </PropertyGroup>

  <Target Name="PostBuild-AnyCPU" AfterTargets="Build" Condition="'$(RuntimeIdentifier)' == ''">
    <MakeDir Directories="$(OutDir)runtimes\win-x86\native;$(OutDir)runtimes\win-x64\native" />
    <Copy SourceFiles="$(NativeOutputRoot)\Win32\Ijwhost.dll"
          DestinationFolder="$(OutDir)runtimes\win-x86\native"
          SkipUnchangedFiles="true"
          Condition="Exists('$(NativeOutputRoot)\Win32\Ijwhost.dll')" />
    <Copy SourceFiles="$(NativeOutputRoot)\Win32\MikuMikuLibrary.Native.dll"
          DestinationFolder="$(OutDir)runtimes\win-x86\native"
          SkipUnchangedFiles="true"
          Condition="Exists('$(NativeOutputRoot)\Win32\MikuMikuLibrary.Native.dll')" />
    <Copy SourceFiles="$(NativeOutputRoot)\x64\Ijwhost.dll"
          DestinationFolder="$(OutDir)runtimes\win-x64\native"
          SkipUnchangedFiles="true"
          Condition="Exists('$(NativeOutputRoot)\x64\Ijwhost.dll')" />
    <Copy SourceFiles="$(NativeOutputRoot)\x64\MikuMikuLibrary.Native.dll"
          DestinationFolder="$(OutDir)runtimes\win-x64\native"
          SkipUnchangedFiles="true"
          Condition="Exists('$(NativeOutputRoot)\x64\MikuMikuLibrary.Native.dll')" />
    <Warning Code="MMM001"
             Text="MikuMikuLibrary.Native.dll was not found. Build MikuMikuLibrary.Native before opening textures or set MIKUMIKULIBRARY_NATIVE_PATH at runtime."
             Condition="!Exists('$(NativeOutputRoot)\Win32\MikuMikuLibrary.Native.dll') And !Exists('$(NativeOutputRoot)\x64\MikuMikuLibrary.Native.dll')" />
  </Target>

  <Target Name="PostPublish-X86" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'win-x86'">
    <Error Text="MikuMikuLibrary.Native.dll is missing. Build MikuMikuLibrary.Native before publishing."
           Condition="!Exists('$(NativeOutputRoot)\Win32\MikuMikuLibrary.Native.dll')" />
    <Copy SourceFiles="$(NativeOutputRoot)\Win32\Ijwhost.dll;$(NativeOutputRoot)\Win32\MikuMikuLibrary.Native.dll"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>   
  
  <Target Name="PostPublish-X64" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <Error Text="MikuMikuLibrary.Native.dll is missing. Build MikuMikuLibrary.Native before publishing."
           Condition="!Exists('$(NativeOutputRoot)\x64\MikuMikuLibrary.Native.dll')" />
    <Copy SourceFiles="$(NativeOutputRoot)\x64\Ijwhost.dll;$(NativeOutputRoot)\x64\MikuMikuLibrary.Native.dll"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target> 
  
</Project>
