<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
    <!-- Keep RID-specific publishes compatible with Visual Studio's x64 solution platform. -->
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-x86'">x86</PlatformTarget>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-x64'">x64</PlatformTarget>
    <OutputType>Exe</OutputType>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\MikuMikuLibrary.snk</AssemblyOriginatorKeyFile>
    <AssemblyVersion>0.2</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MikuMikuLibrary\MikuMikuLibrary.csproj" />
  </ItemGroup>

  <Import Project="..\..\MikuMikuLibrary.Shared\MikuMikuLibrary.Shared.projitems" Label="Shared" />

</Project>
